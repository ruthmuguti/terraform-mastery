# Copy to .env for local dev. Never commit real values.
# On Amplify, set these as app environment variables; amplify.yml writes them
# into .env.production at build time.

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase Dashboard → Connect → ORM tab
# Transaction-mode pooler (port 6543), used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (port 5432), used by Prisma CLI (db push / migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Auth.js / NextAuth v5 ────────────────────────────────────────────────────
# Generate with: npx auth secret   or   openssl rand -base64 32
AUTH_SECRET="<generated-secret>"
# Optional legacy alias; only used if AUTH_SECRET is unset
# NEXTAUTH_SECRET="<generated-secret>"

# Public base URL of the app.
# Local: http://localhost:3000   Amplify: https://main.<app-id>.amplifyapp.com
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Required behind a proxy/CDN (Amplify). Also set explicitly in src/lib/auth.ts.
AUTH_TRUST_HOST=true

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID="<github-client-id>"
GITHUB_CLIENT_SECRET="<github-client-secret>"
# Alternative names also accepted (AUTH_GITHUB_ID / AUTH_GITHUB_SECRET)
