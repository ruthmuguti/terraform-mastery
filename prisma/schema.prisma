generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  profile    Profile?
  credential Credential?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  username          String   @unique
  xp                Int      @default(0)
  level             Int      @default(1)
  streakDays        Int      @default(1)
  lastActiveAt      DateTime @default(now())
  totalCommands     Int      @default(0)
  terraformApplies  Int      @default(0)
  hintsUsed         Int      @default(0)
  missionsAttempted Int      @default(0)
  provider          String?  // "aws" | "gcp" | "azure", validated in code
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionProgress MissionProgress[]
  unlockedBadges  UnlockedBadge[]
}

model MissionProgress {
  id                  String    @id @default(cuid())
  profileId           String
  missionId           String
  status              String    @default("available")
  startedAt           DateTime?
  completedAt         DateTime?
  hintsUsed           Int       @default(0)
  commandCount        Int       @default(0)
  completedObjectives String[]  @default([])
  verified            Boolean   @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, missionId])
}

model UnlockedBadge {
  id         String   @id @default(cuid())
  profileId  String
  badgeId    String
  unlockedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, badgeId])
}

model Credential {
  id        String   @id @default(cuid())
  userId    String   @unique
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
